# MẪU secrets cho Streamlit Community Cloud.
# KHÔNG điền key thật vào file này (nó được commit). Khi deploy, vào dashboard
# app → Settings → Secrets → dán nội dung BÊN DƯỚI (đã điền key thật) vào đó.
# Streamlit tự nạp các key này thành biến môi trường nên code đọc os.environ chạy y hệt local.

# Toss Open API (tùy chọn — chỉ cần nếu muốn giá realtime Toss)
TOSS_CLIENT_ID = "dán_client_id"
TOSS_CLIENT_SECRET = "dán_client_secret"

# OpenDART (tùy chọn — để có 5 năm thực + bảng cân đối gốc)
DART_API_KEY = "dán_open_dart_key"
